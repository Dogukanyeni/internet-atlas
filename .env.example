# Copy this file to .env and fill in the values.
# .env is never committed. Every variable here must exist, or the API refuses to start.

# --- App ---
ATLAS_ENV=local                 # local | preview | production
ATLAS_DEBUG=true
ATLAS_SECRET_KEY=change-me-to-a-long-random-string
ATLAS_API_URL=http://localhost:8000
ATLAS_WEB_URL=http://localhost:3000

# --- Database ---
# Local values match docker-compose.yml
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5433/atlas

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3 compatible, MinIO locally) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=atlasminio
S3_SECRET_KEY=atlasminio
S3_BUCKET=atlas-local
S3_REGION=auto

# --- Feature switches ---
# Both stay off outside production. See ADR-013 and the Phase 4 environment matrix.
ATLAS_CRAWLER_ENABLED=false
ATLAS_AI_ENABLED=false

# --- Email (Phase 8) ---
EMAIL_BACKEND=console           # console | smtp | provider
EMAIL_FROM=noreply@localhost

# --- AI provider (Phase 30, unused before that) ---
ANTHROPIC_API_KEY=
