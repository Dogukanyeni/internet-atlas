            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "short_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Short Description"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "website_count": {
            "minimum": 0,
            "title": "Website Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "slug",
          "created_at",
          "updated_at",
          "name",
          "website_count"
        ],
        "title": "TechnologySummary",
        "type": "object"
      },
      "TopicDetail": {
        "additionalProperties": false,
        "properties": {
          "children": {
            "items": {
              "$ref": "#/components/schemas/TopicSummary"
            },
            "title": "Children",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "featured_websites": {
            "items": {
              "$ref": "#/components/schemas/WebsiteSummary"
            },
            "title": "Featured Websites",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "long_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Long Description"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EntityRef"
              },
              {
                "type": "null"
              }
            ],
