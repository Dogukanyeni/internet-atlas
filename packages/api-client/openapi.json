{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "redis": {
            "title": "Redis",
            "type": "boolean"
          }
        },
        "required": [
          "database",
          "redis"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "InfoResponse": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "environment"
        ],
        "title": "InfoResponse",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LiveResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "dependencies": {
            "$ref": "#/components/schemas/DependencyStatus"
          },
          "status": {
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "ReadyResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Discovery platform for the technology ecosystem.",
    "title": "Internet Atlas API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/info": {
      "get": {
        "operationId": "info_health_info_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfoResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Info",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
