      },
      "WebsiteCreate": {
        "additionalProperties": false,
        "description": "Admin input. Note what is missing: no id, no status, no quality score.\n\nThe server owns those. Letting a client choose an id or publish directly would move\neditorial rules out of the service layer, which is where they belong.",
        "properties": {
          "canonical_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Canonical Url",
            "type": "string"
          },
          "category_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Category Ids",
            "type": "array"
          },
          "kind": {
            "$ref": "#/components/schemas/WebsiteKind"
          },
          "launch_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Launch Date"
          },
          "long_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Long Description"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "organization_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Organization Name"
          },
          "short_description": {
            "maxLength": 160,
            "minLength": 10,
            "title": "Short Description",
            "type": "string"
          },
          "slug": {
            "anyOf": [
              {
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Generated from the name when not given.",
            "title": "Slug"
          },
          "topic_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Topic Ids",
            "type": "array"
          }
        },
        "required": [
          "name",
          "canonical_url",
          "kind",
          "short_description",
          "category_ids"
        ],
        "title": "WebsiteCreate",
        "type": "object"
      },
      "WebsiteDetail": {
        "additionalProperties": false,
        "description": "Everything one website page needs, in one response.\n\nThe detail page must answer four questions on one screen (Phase 2, F1): what is it,\nwhich area, what is it connected to, what are the alternatives. So relations travel\nwith the record instead of needing a second request.",
        "properties": {
          "archive_reason": {
            "anyOf": [
